{% assign repo_parts = include.repository.repo | split: '/' %}
{% assign owner = repo_parts[0] %}
{% assign name = repo_parts[1] %}
{% assign desc = include.repository.description %}
{% assign lang = include.repository.language %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository.repo }}" target="_blank" style="text-decoration:none;">
    <div class="card border" style="border-radius:8px; padding:1rem; text-align:left; transition:box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.15)'" onmouseout="this.style.boxShadow='none'">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.4rem;">
        <svg height="16" width="16" viewBox="0 0 16 16" aria-hidden="true" style="fill:var(--global-text-color); flex-shrink:0;"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8Z"/></svg>
        <span style="font-weight:600; color:var(--global-theme-color); font-size:0.95em;">{{ owner }}/{{ name }}</span>
      </div>
      {% if desc %}
      <p style="font-size:0.82em; color:var(--global-text-color); margin:0 0 0.5rem 0; line-height:1.4;">{{ desc }}</p>
      {% endif %}
      {% if lang %}
      <span style="font-size:0.78em; color:var(--global-text-color-light, #888);">● {{ lang }}</span>
      {% endif %}
    </div>
  </a>
</div>
